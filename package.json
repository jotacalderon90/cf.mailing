{
  "name": "cl.jotacalderon.cf.mailing",
  "description": "sistema para gestión de correos",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node app",
    "dev": "npx nodemon --legacy-watch app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "prepare": "husky || true",
    "check-npm": "npm outdated"
  },
  "lint-staged": {
    "*.js": "eslint --fix"
  },
  "jest": {
    "testMatch": [
      "**/backend__tests__/**/*.test.js"
    ]
  },
  "dependencies": {
    "cl.jotacalderon.cf.framework": "1.16.0",
    "nodemailer": "10.5.0",
    "zod": "4.6.7",
    "luxon": "3.7.2",
		"node-cron": "4.6.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "prettier": "3.10.1"
  }
}
