#####################################
#DATOS GLOBALES FRAMEWORK TRASCENDER#
#####################################

#Puerto del sistema a utilizar, debe coincidir con el archivo de docker-compose
PORT=2205

#Host del sistema, en dev: http://ip:puerto, en prod: https://www.tudominio.com
HOST=http://localhost:2205

#Titulo del sistema, usado en title Front
TITLE=Gestor de correos

#IPs que pueden invocar este servicio en producción (separadas por ,)
#IPS_VALIDAS=


##############################
#INTEGRACION DE OTROS SISTEMAS
##############################


#Host archivos públicos
HOST_ARCHIVOSPUBLICOS=http://localhost:2201

#Host de cuentas
HOST_ACCOUNT=http://account:2202

#Host de cuentas
HOST_ARCHIVOSPRIVADOS=http://archivosprivados:2203

#Host de analitica
#HOST_ANALYTIC=
#HOST_ANALYTIC_X_API_KEY=

#Host de errores
#HOST_ERROR=
#HOST_ERROR_X_API_KEY=

#Host para menu
HOST_DATABASE=http://localhost:2204


###############
#Autenticacion#
###############


#Llave compartida entre aplicaciones para el manejo de la sesion
SESSION_SECRET=trascender-con-sso

#Para produccion, dominio permitido para uso de cookie
#COOKIE_DOMAIN=


###############
#*****BD******#
###############

#Motor (mongo)
DB_MOTOR=mongo

MONGO_URL=mongodb://mongodb_service:27017
MONGO_DBNAME=miscolecciones

#Datos para redis
REDIS_HOST=redis_service
REDIS_PORT=6379
REDIS_PASS=
REDIS_USER=
REDIS_DB=0
REDIS_PREFIX=mailing:


#########################
#DATOS EXTRAS PRODUCCION#
#########################


#Para producción, valida que sistema solo pueda ser llamado por dominios y no por ips
#ONLYDOMAIN=1

#Sistema con multiples front = 1
FRONT_MULTIDOMAIN=1

#Para desarrollo
TEST_HOST=mailing.jotace.cl

#recaptchas
#RECAPTCHA_PUBLIC=
#RECAPTCHA_PRIVATE=

#configuracion cron que envía correo, por defecto cada 1 minuto
#CRON_CHEDULE_SENDER=* * * * *

#configuracion cron que refresca plantillas, para dev cada 1 minuto, para prod cada 1 hora
#CRON_CHEDULE_REFRESH_TEMPLATES=* * * * *

#integración swagger
SWAGGER=/api/swagger

#Zona horaria
TIMEZONE=America/Santiago

#Llave de 64 caracteres para encriptar correo que permitira al usuario desubscribirse a las notificaciones por correo
SECRET_KEY_UNSUBSCRIBE=5b5a7fb1e64f323ac7985babea64efc2ecb7de02ec1cc1928505b74fd4e26fa1
